# Todas as variaveis abaixo sao opcionais. Sem elas, o sistema roda 100% funcional em
# modo mock (base local de reputacao + notificacoes registradas em modo console).

# Threat intelligence real
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Notificacao real (Slack tem prioridade se ambos estiverem preenchidos)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Intervalo (em segundos) do worker que reexecuta o playbook automaticamente
PLAYBOOK_INTERVAL_SECONDS=60
